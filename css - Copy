/* =========================
   CINEMATIC SLIDESHOW
========================= */

.cinematic-slideshow {
    position: relative;
    width: 100%;
    height: 500px;
    margin: 35px auto;
    overflow: hidden;
    border-radius: 25px;
    background: #000;
    box-shadow:
        0 0 40px rgba(255, 40, 90, .18);
}

.slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transform: scale(1.08);
    transition:
        opacity 1.5s ease,
        transform 7s ease;
}

.slide.active {
    opacity: 1;
    transform: scale(1);
}

.slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;

    /* efek blur sedikit */
    filter: blur(1.5px) brightness(.65);

    transform: scale(1.04);
}

/* efek gelap */
.slide-overlay {
    position: absolute;
    inset: 0;

    background:
        linear-gradient(
            to top,
            rgba(0,0,0,.85),
            rgba(0,0,0,.15),
            rgba(0,0,0,.45)
        );

    pointer-events: none;
}

/* tulisan di atas foto */
.slide-text {
    position: absolute;
    left: 30px;
    bottom: 30px;
    z-index: 5;
}

.slide-text span {
    font-size: 12px;
    letter-spacing: 5px;
    color: #ff7899;
}

.slide-text h2 {
    margin-top: 8px;
    font-size: 28px;
    font-weight: 500;
    text-shadow: 0 2px 15px #000;
}

/* titik indikator */
.slide-dots {
    position: absolute;
    bottom: 18px;
    right: 25px;
    z-index: 10;
}

.slide-dot {
    display: inline-block;
    width: 7px;
    height: 7px;
    margin: 3px;
    border-radius: 50%;
    background: rgba(255,255,255,.35);
    transition: .4s;
}

.slide-dot.active {
    width: 22px;
    border-radius: 10px;
    background: #ff668c;
}

/* HP */
@media(max-width:600px) {

    .cinematic-slideshow {
        height: 400px;
        border-radius: 20px;
    }

    .slide-text {
        left: 20px;
        bottom: 25px;
    }

    .slide-text h2 {
        font-size: 22px;
    }
}